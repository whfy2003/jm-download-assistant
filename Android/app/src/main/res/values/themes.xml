<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.JmComic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <!-- 关键：窗口背景跟随主题色，避免 recreate 时闪一帧白屏 -->
        <item name="android:windowBackground">@color/surface</item>
        <!-- 去掉 Activity 切换/重建时的窗口动画，深色切换不再"闪一下" -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium" />

    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Mono.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- 列表封面缩略图圆角 -->
    <style name="ShapeAppearance.Jm.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

</resources>
